{
  "overview_p0_cves": {
    "index": "wazuh-vuln-cve-summary-latest",
    "body": {
      "size": 0,
      "query": { "term": { "priority": "P0" } }
    }
  },
  "top_risk_cves": {
    "index": "wazuh-vuln-cve-summary-latest",
    "body": {
      "size": 10,
      "sort": [
        { "risk_score": "desc" },
        { "affected_hosts_count": "desc" }
      ],
      "_source": [
        "cve_id",
        "priority",
        "patch_decision",
        "kev",
        "public_poc",
        "poc_count",
        "epss_score",
        "cvss_score",
        "affected_hosts_count",
        "affected_packages",
        "verification_status",
        "exploitability_status",
        "exposure_status",
        "impact_assessment",
        "recommended_action",
        "mitigation_status",
        "workaround_verified",
        "workaround_check_passed",
        "workaround_check_failed",
        "reason"
      ]
    }
  },
  "top_hosts": {
    "index": "wazuh-vuln-host-summary-latest",
    "body": {
      "size": 10,
      "sort": [
        { "p0_count": "desc" },
        { "kev_count": "desc" },
        { "highest_epss": "desc" }
      ],
      "_source": [
        "agent_id",
        "agent_name",
        "agent_ip",
        "os_name",
        "total_cves",
        "patch_now_count",
        "workaround_active_count",
        "patch_scheduled_count",
        "cleanup_old_kernel_count",
        "needs_review_count",
        "p0_count",
        "p1_count",
        "kev_count",
        "highest_epss",
        "highest_cvss",
        "top_packages"
      ]
    }
  },
  "cve_drill_down": {
    "index": "wazuh-vuln-enriched-latest",
    "body": {
      "size": 1000,
      "query": { "term": { "cve_id": "CVE-2026-0000" } },
      "sort": [{ "risk_score": "desc" }]
    }
  },
  "host_drill_down": {
    "index": "wazuh-vuln-enriched-latest",
    "body": {
      "size": 1000,
      "query": { "term": { "agent_id": "001" } },
      "sort": [{ "risk_score": "desc" }]
    }
  },
  "critical_real_impact_cves": {
    "index": "wazuh-vuln-cve-summary-latest",
    "body": {
      "size": 25,
      "query": {
        "bool": {
          "filter": [
            { "term": { "patch_decision": "patch_now" } },
            { "terms": { "verification_status": ["confirmed_affected", "likely_affected"] } },
            { "range": { "affected_hosts_count": { "gte": 1 } } }
          ],
          "should": [
            { "term": { "exploitability_status": "exploited_in_wild" } },
            { "term": { "public_poc": true } },
            { "range": { "epss_score": { "gte": 0.7 } } }
          ],
          "minimum_should_match": 1
        }
      },
      "sort": [
        { "risk_score": "desc" },
        { "affected_hosts_count": "desc" }
      ],
      "_source": [
        "cve_id",
        "patch_decision",
        "impact_assessment",
        "verification_status",
        "exploitability_status",
        "kev",
        "public_poc",
        "fix_available",
        "vendor_fixed_version",
        "recommended_action",
        "mitigation_status",
        "workaround_verified",
        "workaround_check_passed",
        "workaround_check_failed",
        "priority",
        "epss_score",
        "cvss_score",
        "affected_hosts_count",
        "affected_packages",
        "exposure_status",
        "poc_count",
        "poc_references"
      ]
    }
  },
  "needs_review_cves": {
    "index": "wazuh-vuln-cve-summary-latest",
    "body": {
      "size": 25,
      "query": {
        "bool": {
          "filter": [
            { "range": { "affected_hosts_count": { "gte": 1 } } }
          ],
          "should": [
            { "term": { "patch_decision": "needs_review" } },
            {
              "bool": {
                "filter": [
                  { "terms": { "verification_status": ["vendor_not_found", "needs_manual_check", "not_verified"] } }
                ],
                "should": [
                  { "term": { "kev": true } },
                  { "term": { "public_poc": true } },
                  { "range": { "epss_score": { "gte": 0.7 } } }
                ],
                "minimum_should_match": 1
              }
            }
          ],
          "minimum_should_match": 1
        }
      },
      "sort": [
        { "risk_score": "desc" },
        { "affected_hosts_count": "desc" }
      ],
      "_source": [
        "cve_id",
        "patch_decision",
        "impact_assessment",
        "verification_status",
        "exploitability_status",
        "kev",
        "public_poc",
        "fix_available",
        "vendor_fixed_version",
        "recommended_action",
        "priority",
        "epss_score",
        "cvss_score",
        "affected_hosts_count",
        "affected_packages",
        "exposure_status",
        "poc_count",
        "poc_references"
      ]
    }
  },
  "patch_scheduled_cves": {
    "index": "wazuh-vuln-cve-summary-latest",
    "body": {
      "size": 25,
      "query": {
        "bool": {
          "filter": [
            { "terms": { "patch_decision": ["patch_scheduled", "cleanup_old_kernel", "workaround_active"] } },
            { "range": { "affected_hosts_count": { "gte": 1 } } }
          ]
        }
      },
      "sort": [
        { "risk_score": "desc" },
        { "affected_hosts_count": "desc" }
      ],
      "_source": [
        "cve_id",
        "patch_decision",
        "impact_assessment",
        "verification_status",
        "exploitability_status",
        "kev",
        "public_poc",
        "fix_available",
        "vendor_fixed_version",
        "recommended_action",
        "mitigation_status",
        "workaround_verified",
        "workaround_check_passed",
        "workaround_check_failed",
        "priority",
        "epss_score",
        "cvss_score",
        "affected_hosts_count",
        "affected_packages",
        "exposure_status",
        "poc_count",
        "poc_references"
      ]
    }
  }
}
